from tvDatafeed import TvDatafeed, Interval
import pandas as pd
from datetime import datetime, time
import time as tm
import winsound   # Windows only

# ================= CONFIG =================
NIFTY_100 = [
"ADANIENT","ADANIPORTS","AMBUJACEM","APOLLOHOSP","ASIANPAINT",
"AUROPHARMA","AXISBANK","BAJAJ-AUTO","BAJFINANCE","BAJAJFINSV",
"BANDHANBNK","BANKBARODA","BERGEPAINT","BHARATFORG","BHARTIARTL",
"BPCL","BRITANNIA","CANBK","CHOLAFIN","CIPLA","COALINDIA",
"DABUR","DIVISLAB","DRREDDY","EICHERMOT","GAIL","GRASIM",
"HCLTECH","HDFCBANK","HDFCLIFE","HEROMOTOCO","HINDALCO",
"HINDUNILVR","ICICIBANK","INDUSINDBK","INFY","ITC","JSWSTEEL",
"KOTAKBANK","LT","M&M","MARUTI","NTPC","ONGC","POWERGRID",
"RELIANCE","SBIN","SUNPHARMA","TATAMOTORS","TATASTEEL",
"TECHM","TITAN","ULTRACEMCO","UPL","WIPRO"
]

ENTRY_START = time(9, 20)
ENTRY_END   = time(14, 45)
MAX_TRADES_PER_DAY = 3
RR = 1.5

tv = TvDatafeed()

# ================= STATE =================
daily_trade_count = 0
traded_symbols = set()
current_day = datetime.now().date()

# ================= HELPERS =================
def normalize(df):
    df = df.reset_index()
    if "datetime" in df.columns:
        df.rename(columns={"datetime": "Datetime"}, inplace=True)

    rename = {}
    for c in df.columns:
        if c.lower() == "open": rename[c] = "Open"
        if c.lower() == "high": rename[c] = "High"
        if c.lower() == "low": rename[c] = "Low"
        if c.lower() == "close": rename[c] = "Close"
        if c.lower() == "volume": rename[c] = "Volume"

    df.rename(columns=rename, inplace=True)
    return df

def strong_bullish_engulfing(df, i):
    if i < 20:
        return False
    c, p = df.iloc[i], df.iloc[i-1]

    body_c = abs(c["Close"] - c["Open"])
    body_p = abs(p["Close"] - p["Open"])
    rng = c["High"] - c["Low"]

    avg_rng = (df["High"] - df["Low"]).rolling(10).mean().iloc[i]
    avg_vol = df["Volume"].rolling(20).mean().iloc[i]

    return (
        c["Close"] > c["Open"] and
        c["Close"] > p["Close"] and
        body_c > body_p and
        body_c >= 0.6 * rng and
        rng >= 1.2 * avg_rng and
        c["Volume"] >= 1.5 * avg_vol
    )

def get_rsh(symbol):
    d5 = tv.get_hist(symbol, "NSE", Interval.in_5_minute, 400)
    d15 = tv.get_hist(symbol, "NSE", Interval.in_15_minute, 200)

    if d5 is None or d15 is None:
        return None

    d5 = normalize(d5)
    d15 = normalize(d15)

    prev_day = (datetime.now().date() - pd.Timedelta(days=1))
    p5 = d5[d5["Datetime"].dt.date == prev_day]
    if p5.empty:
        return None

    return p5["High"].max()

# ================= LIVE SCAN =================
def scan_once():
    global daily_trade_count, current_day

    now = datetime.now()
    if not (ENTRY_START <= now.time() <= ENTRY_END):
        return

    # Reset day
    if now.date() != current_day:
        current_day = now.date()
        daily_trade_count = 0
        traded_symbols.clear()

    if daily_trade_count >= MAX_TRADES_PER_DAY:
        return

    for symbol in NIFTY_100:
        if symbol in traded_symbols:
            continue

        df = tv.get_hist(symbol, "NSE", Interval.in_5_minute, 120)
        if df is None:
            continue

        df = normalize(df)
        i = len(df) - 1
        candle = df.iloc[i]

        rsh = get_rsh(symbol)
        if rsh is None or candle["High"] <= rsh:
            continue

        if not strong_bullish_engulfing(df, i):
            continue

        entry = candle["Close"]
        sl = candle["Low"]
        target = entry + RR * (entry - sl)

        # ===== ALERT =====
        print("\n🚀 TRADE ALERT")
        print(f"Stock  : {symbol}")
        print(f"Time   : {now.strftime('%H:%M')}")
        print(f"Entry  : {round(entry,2)}")
        print(f"SL     : {round(sl,2)}")
        print(f"Target : {round(target,2)}")

        winsound.Beep(1000, 800)

        traded_symbols.add(symbol)
        daily_trade_count += 1

        if daily_trade_count >= MAX_TRADES_PER_DAY:
            break

# ================= MAIN LOOP =================
print("🔴 Live scanner started...")

while True:
    scan_once()
    tm.sleep(300)  # wait 5 minutes
